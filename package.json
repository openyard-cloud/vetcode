{
  "name": "vetcode",
  "version": "0.3.0",
  "private": true,
  "description": "Security check for apps, websites and servers, for any AI coding agent: Agent Skill, MCP server and CLI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "skills/",
    "mcp/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "scan": "node skills/vetcode/scripts/vet.mjs",
    "zip": "cd skills && rm -f ../vetcode-skill.zip && zip -qr ../vetcode-skill.zip vetcode"
  },
  "bin": {
    "vetcode": "skills/vetcode/scripts/vet.mjs",
    "vetcode-mcp": "mcp/server.mjs"
  }
}
